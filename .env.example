# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Database Configuration
PORT=3000
NODE_ENV="development"
MONGODB_URI="mongodb://localhost:27017/synthetix_portfolio"

# Authentication & Security
JWT_SECRET="synthetix_super_secret_jwt_key_2025"
JWT_REFRESH_SECRET="synthetix_super_secret_refresh_jwt_key_2025"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Admin Credentials for Seed
DEFAULT_ADMIN_NAME="Vance R. Sterling"
DEFAULT_ADMIN_EMAIL="admin@synthetix.ai"
DEFAULT_ADMIN_PASSWORD="Admin@123456"

# Cloudinary (Optional, local file storage fallback is included)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SMTP Mailer (Optional, dev mode logs emails to console)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
CONTACT_RECEIVER_EMAIL="admin@synthetix.ai"
